# Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị thật. KHÔNG commit file .env.
# Origin của công ty trên Antco, không đường dẫn, không dấu / cuối.
ANTCO_BASE_URL=https://<cong-ty>.antco.com.vn
# API token tạo ở Antco: Cài đặt > Tích hợp > API Token (chỉ hiện 1 lần). Dán nguyên giá trị, không dấu nháy.
ANTCO_API_KEY=
